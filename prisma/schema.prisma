generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id             String   @id @default(cuid())
  name           String
  faceDescriptor String   // Representação serializada (JSON) do vetor numérico de características faciais
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
